+            elif key in (ord(";"), ord("'")) and placement.up is None:
+                placement.pitch += 1 if key == ord("'") else -1
+    finally:
+        if args.save and composite is not None:
+            cv2.imwrite(args.save, composite)
+        source.close()
+        view.close()
+        if not args.headless:
+            cv2.destroyAllWindows()
+
