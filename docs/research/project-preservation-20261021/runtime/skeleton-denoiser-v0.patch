                 filters.setdefault(i, OneEuro())(p, t_now)
             smoothed = {i: f.x_prev.copy() for i, f in filters.items() if i in raw}
 
+            # Лег-денойзер (denoiser_ov): root-relative коррекция суставов 11..16.
